# Raw computational job files (~11 GB) — archived to Zenodo, fetched on demand.
data/computational_data_raw/*

# Except the tables the extraction scripts write next to the jobs they read, which the
# property workbooks in computational_data_processed/ are assembled from.
!data/computational_data_raw/photocatalysts_new_ids/
data/computational_data_raw/photocatalysts_new_ids/*
!data/computational_data_raw/photocatalysts_new_ids/photocatalyst_dft.csv
!data/computational_data_raw/organophotocatalysts/
data/computational_data_raw/organophotocatalysts/*
!data/computational_data_raw/organophotocatalysts/organophotocatalyst_dft.csv
!data/computational_data_raw/quencher_adiabatic_DFT/
data/computational_data_raw/quencher_adiabatic_DFT/*
!data/computational_data_raw/quencher_adiabatic_DFT/quencher_dft.csv
!data/computational_data_raw/quencher_adiabatic_DvTE/
data/computational_data_raw/quencher_adiabatic_DvTE/*
!data/computational_data_raw/quencher_adiabatic_DvTE/quencher_dvte.csv
!data/computational_data_raw/quencher_adiabatic_DvTE/quencher_dvte_samples.csv.gz
!data/computational_data_raw/quencher_adiabatic_DvTE/quencher_timings_vertical_sp.csv.gz

# data/ has one README, data/README.md. None below it.
data/*/**/README.md

# The best checkpoint so far of a running ml/training/train.py, renamed to model.pt when the
# run ends.
ml/results/**/*.pt.partial

# The alternative Stern-Volmer fit through (0, 1), written only on request.
data/experimental_data_processed/stern_volmer_fits_fixed_intercept.csv

# Site-specific deployment: the image build and the university cluster manifests, not published.
webapp/deploy/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Sync clients
.owncloudsync.log
*.owncloudsync.log.*
*~sync-conflict*
