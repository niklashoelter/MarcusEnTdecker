# Raw computational job files (~11 GB) — archived to Zenodo, fetched on demand.
# The README explaining what belongs there is kept.
data/computational_data_raw/*
!data/computational_data_raw/README.md

# The photocatalyst manifest is the one exception: 512 rows saying which delivered job
# was kept, which was dropped and why. It is small, and it is the part of the deposit
# that has to remain readable without the 483 MB it describes.
!data/computational_data_raw/photocatalysts/
data/computational_data_raw/photocatalysts/*
!data/computational_data_raw/photocatalysts/manifest.csv

# The pyrates package in ml/ IS committed, checkpoint included, so that
# the deployed model is pinned by this repository. Its own .gitignore was removed for
# exactly that reason — see ml/README.md.

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Sync clients
.owncloudsync.log
*.owncloudsync.log.*
*~sync-conflict*

# Local overrides
paths.local.toml
