# Raw computational job files (~11 GB) — archived to Zenodo, fetched on demand.
# The README explaining what belongs there is kept.
data/computational_data_raw/*
!data/computational_data_raw/README.md

# The vendored package in ml/upstream/ IS committed, checkpoint included, so that
# the deployed model is pinned by this repository. Its own .gitignore was removed for
# exactly that reason — see ml/upstream/PROVENANCE.md.

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Sync clients
.owncloudsync.log
*.owncloudsync.log.*
*~sync-conflict*

# Local overrides
paths.local.toml
